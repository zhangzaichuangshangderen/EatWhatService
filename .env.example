# 复制为 .env 后填写：cp .env.example .env

# ---- MySQL ----
# root 密码（用于健康检查与紧急维护）
MYSQL_ROOT_PASSWORD=请改成强密码例如EatWhat@2026
# 应用连接数据库用的账号密码（与 docker-compose.yml 中 MYSQL_USER 对应）
MYSQL_PASSWORD=请改成强密码例如EatWhatDb@2026

# ---- 微信小程序（自建部署后用于 code2session 换取 openid）----
# 微信小程序 AppID
WX_APPID=wx0d0a168083a49226
# 小程序 AppSecret（微信公众平台 -> 开发管理 -> 开发设置 获取）
WX_SECRET=aa181e4cbbd49a9a338fd571502ea5e3

# ---- JWT 登录态 ----
# 务必改成随机强密钥（例如 openssl rand -base64 48 生成），且所有实例保持一致
JWT_SECRET=EWNVgbg4amvi1RowKy7EtDOhpNcR525iy7EO6srJD8k5kMh7xkyL9dR9by3mCut2
# token 有效期（小时），默认 720（30 天）
JWT_EXPIRE_HOURS=720

# ---- 文件上传 ----
# 头像等上传文件在容器内的保存目录（已通过 named volume 持久化）
UPLOAD_DIR=/data/uploads
