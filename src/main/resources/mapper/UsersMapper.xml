<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.tencent.wxcloudrun.dao.UsersMapper">

    <resultMap id="userProfileMapper" type="com.tencent.wxcloudrun.model.UserProfile">
        <result property="userId" column="userId"/>
        <result property="nickName" column="nickName"/>
        <result property="avatarUrl" column="avatarUrl"/>
        <result property="createdAt" column="createdAt" javaType="java.time.LocalDateTime"/>
        <result property="updatedAt" column="updatedAt" javaType="java.time.LocalDateTime"/>
    </resultMap>

    <select id="findByUserId" resultMap="userProfileMapper">
        SELECT `userId`, `nickName`, `avatarUrl`, `createdAt`, `updatedAt`
        FROM `Users`
        WHERE `userId` = #{userId}
    </select>

    <insert id="insertIgnore">
        INSERT INTO `Users`(`userId`)
        VALUES (#{userId})
        ON DUPLICATE KEY UPDATE
          `userId` = `userId`
    </insert>

    <update id="updateProfile" parameterType="com.tencent.wxcloudrun.model.UserProfile">
        UPDATE `Users`
        <set>
            <if test="nickName != null and nickName != ''">
                `nickName` = #{nickName},
            </if>
            <if test="avatarUrl != null and avatarUrl != ''">
                `avatarUrl` = #{avatarUrl},
            </if>
            `updatedAt` = CURRENT_TIMESTAMP
        </set>
        WHERE `userId` = #{userId}
    </update>

</mapper>
